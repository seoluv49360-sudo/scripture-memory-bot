TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
BOT_TOKEN_ROTATION_CONFIRMED=false
MEMBER_ACCESS_TOKEN=replace_with_a_long_random_value
ADMIN_USER_IDS=
SCRIPTURES_FILE=data/scriptures.json
REQUEST_LIMIT_COUNT=12
REQUEST_LIMIT_WINDOW_SECONDS=10
AUTH_FAILURE_LIMIT=5
AUTH_FAILURE_WINDOW_SECONDS=900
AUTH_BLOCK_SECONDS=1800
QUIZ_STATE_TTL_DAYS=3
ERROR_LOG_TTL_DAYS=14
TRANSIENT_NETWORK_ERROR_LOG_INTERVAL_SECONDS=3600
BOT_TOKEN_ROTATION_CONFIRMED=true

# ── 라이브 데모 API (demo_api/, 실제 텔레그램 네트워크 안 씀) 배포용 — 아래는 standalone Caddy를
# 쓸 때만 필요. 기존 공유 Caddy에 합류한다면 이 값들 대신 그 Caddyfile에 직접 값을 채워 넣는다.
DEMO_SITE_DOMAIN=
DEMO_BASIC_AUTH_USER=admin
# 생성: docker run --rm caddy:2-alpine caddy hash-password --plaintext '실제비밀번호'
# .env에 넣을 때 해시 안의 $ 는 전부 $$ 로 두 번씩 적을 것 (docker compose 변수치환 함정)
DEMO_BASIC_AUTH_HASH=
# services-portal이 뜨는 실제 도메인만 콤마로 나열 (CORS 허용 origin, 와일드카드 금지)
DEMO_ALLOWED_ORIGINS=https://portal.nyjmict.com